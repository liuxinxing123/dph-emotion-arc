{
  "name": "dph-emotion-arc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "情绪弧线导演（Emotion Arc Director）：文本情绪识别 → 显式情绪状态文件 → 对话策略映射 + 情绪记忆账本。工具/叙事定位的 DSH（DPH）插件。",
  "exports": {
    ".": "./engine.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["engine.js", "client.js", "locale/*.json", "icon.svg"],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
